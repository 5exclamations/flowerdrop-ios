{
  "sourceLanguage": "ru",
  "strings": {
    "Адрес": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ünvan"
          }
        }
      }
    },
    "Баку": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakı"
          }
        }
      }
    },
    "Букет ваш": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buket sizindir"
          }
        }
      }
    },
    "Букет дня": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün buketi"
          }
        }
      }
    },
    "В мои резервы": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlərimə keç"
          }
        }
      }
    },
    "Витрина токенов и компонентов": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Token və komponent vitrini"
          }
        }
      }
    },
    "Вход по номеру": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrə ilə giriş"
          }
        }
      }
    },
    "Вчерашние букеты": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünənki buketlər"
          }
        }
      }
    },
    "Выбери букет в ленте — войти попросим на резерве.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lentdən buket seçin — giriş yalnız rezerv üçün lazım olacaq."
          }
        }
      }
    },
    "Выйти": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıxış"
          }
        }
      }
    },
    "Демо-режим": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo rejimi"
          }
        }
      }
    },
    "Дизайн-система": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizayn sistemi"
          }
        }
      }
    },
    "Забрал": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldım"
          }
        }
      }
    },
    "Забрать до": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Götürmə vaxtı"
          }
        }
      }
    },
    "Забрать сегодня до 21:00": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün 21:00-dək götürün"
          }
        }
      }
    },
    "Забрать сегодня, до закрытия лавки": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün, dükan bağlanana qədər götürün"
          }
        }
      }
    },
    "Загляни вечером — лавки выкладывают вчерашние букеты после шести.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Axşam qayıdın — dükanlar dünənki buketləri saat altıdan sonra çıxarır."
          }
        }
      }
    },
    "Закрыть": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağla"
          }
        }
      }
    },
    "Зарезервировать": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerv et"
          }
        }
      }
    },
    "Зарезервируй букет — он появится здесь вместе с кодом получения.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buket rezerv edin — götürmə kodu ilə birlikdə burada görünəcək."
          }
        }
      }
    },
    "Итого": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cəmi"
          }
        }
      }
    },
    "Кнопки": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düymələr"
          }
        }
      }
    },
    "Код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod"
          }
        }
      }
    },
    "Код из SMS": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS kodu"
          }
        }
      }
    },
    "Код получения": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Götürmə kodu"
          }
        }
      }
    },
    "Код получения ждёт в «Моих резервах».": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Götürmə kodu «Rezervlərim»dədir."
          }
        }
      }
    },
    "Кто-то успел раньше. Мы обновили ленту.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimsə sizi qabaqladı. Lenti yenilədik."
          }
        }
      }
    },
    "Лента": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent"
          }
        }
      }
    },
    "Лента не загрузилась": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent yüklənmədi"
          }
        }
      }
    },
    "Мои резервы": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlərim"
          }
        }
      }
    },
    "Назад": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Назовите код в лавке — резерв держится до %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu dükanda deyin — buketi %@-dək saxlayırıq"
          }
        }
      }
    },
    "Не получилось зарезервировать": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerv alınmadı"
          }
        }
      }
    },
    "Не удалось отправить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod göndərilmədi"
          }
        }
      }
    },
    "Не удалось проверить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu yoxlaya bilmədik"
          }
        }
      }
    },
    "Не удалось удалить аккаунт": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı silmək alınmadı"
          }
        }
      }
    },
    "Неверный код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yanlışdır"
          }
        }
      }
    },
    "Нет связи с сервером.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverlə əlaqə yoxdur."
          }
        }
      }
    },
    "Нет связи с сервером. Проверьте соединение.": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverlə əlaqə yoxdur. Bağlantını yoxlayın."
          }
        }
      }
    },
    "Номер": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrə"
          }
        }
      }
    },
    "Номер и активные резервы будут удалены без возможности восстановить. Букеты, которые вы держите, вернутся в продажу.": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrə və aktiv rezervlər bərpasız silinəcək. Saxladığınız buketlər yenidən satışa qayıdacaq."
          }
        }
      }
    },
    "Осталось 3 букета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "3 buket qalıb"
          }
        }
      }
    },
    "Отмена": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ləğv et"
          }
        }
      }
    },
    "Отправили на %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nömrəsinə göndərdik"
          }
        }
      }
    },
    "Пионы и эвкалипт": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pion və evkalipt"
          }
        }
      }
    },
    "Повторить": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən cəhd et"
          }
        }
      }
    },
    "Подтвердить резерв": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervi təsdiqlə"
          }
        }
      }
    },
    "Пока нет резервов": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ rezerv yoxdur"
          }
        }
      }
    },
    "Политика конфиденциальности": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məxfilik siyasəti"
          }
        }
      }
    },
    "Получить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu göndər"
          }
        }
      }
    },
    "Понятно": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydındır"
          }
        }
      }
    },
    "Пришлём код в SMS — он нужен, чтобы держать резерв за вами.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS ilə kod göndərəcəyik — buketi sizin adınıza saxlamaq üçün lazımdır."
          }
        }
      }
    },
    "Проверь номер.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrəni yoxlayın."
          }
        }
      }
    },
    "Проверь соединение и попробуй ещё раз.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısını yoxlayın və yenidən cəhd edin."
          }
        }
      }
    },
    "Профиль": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil"
          }
        }
      }
    },
    "Разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Satılıb"
          }
        }
      }
    },
    "Резерв букета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buket rezervi"
          }
        }
      }
    },
    "Резерв держится 2 часа": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buketi 2 saat saxlayırıq"
          }
        }
      }
    },
    "Резерв за минуту — код придёт сразу": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dəqiqəyə rezerv — kod dərhal gəlir"
          }
        }
      }
    },
    "Резервы не загрузились": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlər yüklənmədi"
          }
        }
      }
    },
    "Резервы после входа": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişdən sonra görünəcək"
          }
        }
      }
    },
    "Сегодня всё разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün hamısı satılıb"
          }
        }
      }
    },
    "Сервер ответил ошибкой. Мы уже знаем.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverdə xəta oldu. Artıq bilirik."
          }
        }
      }
    },
    "Сессия истекла. Войдите заново.": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiyanın vaxtı bitdi. Yenidən daxil olun."
          }
        }
      }
    },
    "Скелетоны": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeletonlar"
          }
        }
      }
    },
    "Скидка −50% на то, что не разобрали вчера": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dünən satılmayanlara −50% endirim"
          }
        }
      }
    },
    "Слишком часто. Подожди минуту.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çox tez-tez. Bir dəqiqə gözləyin."
          }
        }
      }
    },
    "Смотреть букеты": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buketlərə bax"
          }
        }
      }
    },
    "Типографика": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipoqrafiya"
          }
        }
      }
    },
    "Только что разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İndicə satıldı"
          }
        }
      }
    },
    "Удаление необратимо. История резервов останется у лавки обезличенной.": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Silmək geri qaytarılmır. Rezerv tarixçəsi dükanda adsız qalacaq."
          }
        }
      }
    },
    "Удалить аккаунт": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı sil"
          }
        }
      }
    },
    "Удалить аккаунт?": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesab silinsin?"
          }
        }
      }
    },
    "Условия использования": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstifadə şərtləri"
          }
        }
      }
    },
    "Цвета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rənglər"
          }
        }
      }
    },
    "Цветочная лавка «Нар»": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nar» gül dükanı"
          }
        }
      }
    },
    "Цены": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qiymətlər"
          }
        }
      }
    },
    "Что-то пошло не так. Попробуйте ещё раз.": {
      "extractionState": "manual",
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəsə alınmadı. Bir daha yoxlayın."
          }
        }
      }
    },
    "Этот букет уже у вас": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu buket artıq sizdədir"
          }
        }
      }
    },
    "до %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-dək"
          }
        }
      }
    },
    "истёк": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "vaxtı bitib"
          }
        }
      }
    },
    "осталось %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qalıb"
          }
        }
      }
    },
    "осталось %lld": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld qalıb"
          }
        }
      }
    },
    "получен": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "götürülüb"
          }
        }
      }
    }
  },
  "version": "1.0"
}
