{
  "sourceLanguage": "ru",
  "strings": {
    "Адрес": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ünvan"
          }
        }
      }
    },
    "Баку": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakı"
          }
        }
      }
    },
    "Букет ваш": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buket sizindir"
          }
        }
      }
    },
    "Букет дня": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Günün buketi"
          }
        }
      }
    },
    "В мои резервы": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlərimə"
          }
        }
      }
    },
    "Витрина токенов и компонентов": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenlər və komponentlər vitrini"
          }
        }
      }
    },
    "Вход по номеру": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrə ilə giriş"
          }
        }
      }
    },
    "Выбери букет в ленте — войти попросим на резерве.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lentdən buket seç — girişi rezerv zamanı istəyəcəyik."
          }
        }
      }
    },
    "Дизайн-система": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizayn sistemi"
          }
        }
      }
    },
    "до %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-dək"
          }
        }
      }
    },
    "Забрал": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aldım"
          }
        }
      }
    },
    "Забрать до": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Götürmə vaxtı"
          }
        }
      }
    },
    "Забрать сегодня до 21:00": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün 21:00-dək götürün"
          }
        }
      }
    },
    "Загляни вечером — лавки выкладывают вчерашние букеты после шести.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Axşam bax — dükanlar dünənki buketləri altıdan sonra çıxarır."
          }
        }
      }
    },
    "Закрыть": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağla"
          }
        }
      }
    },
    "Зарезервировать": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerv et"
          }
        }
      }
    },
    "Зарезервируй букет — он появится здесь вместе с кодом получения.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buketi rezerv et — alma kodu ilə burada görünəcək."
          }
        }
      }
    },
    "истёк": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "vaxtı bitib"
          }
        }
      }
    },
    "Итого": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yekun"
          }
        }
      }
    },
    "Кнопки": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düymələr"
          }
        }
      }
    },
    "Код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod"
          }
        }
      }
    },
    "Код из SMS": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS-dəki kod"
          }
        }
      }
    },
    "Код получения": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma kodu"
          }
        }
      }
    },
    "Код получения ждёт в «Моих резервах».": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Alma kodu «Rezervlərim»də gözləyir."
          }
        }
      }
    },
    "Кто-то успел раньше. Мы обновили ленту.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimsə sizi qabaqladı. Lenti yenilədik."
          }
        }
      }
    },
    "Лента": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent"
          }
        }
      }
    },
    "Лента не загрузилась": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Lent yüklənmədi"
          }
        }
      }
    },
    "Мои резервы": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlərim"
          }
        }
      }
    },
    "Назад": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Назовите код в лавке — резерв держится до %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu dükanda deyin — rezerv %@-dək qüvvədədir"
          }
        }
      }
    },
    "Не получилось зарезервировать": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerv etmək alınmadı"
          }
        }
      }
    },
    "Не удалось отправить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu göndərmək alınmadı"
          }
        }
      }
    },
    "Не удалось проверить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu yoxlamaq alınmadı"
          }
        }
      }
    },
    "Неверный код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod yanlışdır"
          }
        }
      }
    },
    "Нет связи с сервером.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverlə əlaqə yoxdur."
          }
        }
      }
    },
    "осталось %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ qalıb"
          }
        }
      }
    },
    "осталось %lld": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ədəd qalıb"
          }
        }
      }
    },
    "Осталось 3 букета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "3 buket qalıb"
          }
        }
      }
    },
    "Отправили на %@": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nömrəsinə göndərdik"
          }
        }
      }
    },
    "Пионы и эвкалипт": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Pionlar və evkalipt"
          }
        }
      }
    },
    "Повторить": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən cəhd et"
          }
        }
      }
    },
    "Подтвердить резерв": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervi təsdiqlə"
          }
        }
      }
    },
    "Пока нет резервов": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ rezerv yoxdur"
          }
        }
      }
    },
    "получен": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "alınıb"
          }
        }
      }
    },
    "Получить код": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu al"
          }
        }
      }
    },
    "Понятно": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aydındır"
          }
        }
      }
    },
    "Пришлём код в SMS — он нужен, чтобы держать резерв за вами.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "SMS-lə kod göndərəcəyik — rezervi sizin üçün saxlamaq lazımdır."
          }
        }
      }
    },
    "Проверь номер.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nömrəni yoxla."
          }
        }
      }
    },
    "Проверь соединение и попробуй ещё раз.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantını yoxla və yenidən cəhd et."
          }
        }
      }
    },
    "Разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Satılıb"
          }
        }
      }
    },
    "Резерв букета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Buket rezervi"
          }
        }
      }
    },
    "Резерв держится 2 часа": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerv 2 saat saxlanılır"
          }
        }
      }
    },
    "Резервы не загрузились": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlər yüklənmədi"
          }
        }
      }
    },
    "Резервы после входа": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezervlər girişdən sonra"
          }
        }
      }
    },
    "Сегодня всё разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün hamısı satılıb"
          }
        }
      }
    },
    "Сервер ответил ошибкой. Мы уже знаем.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Server xəta qaytardı. Artıq bilirik."
          }
        }
      }
    },
    "Скелетоны": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeletonlar"
          }
        }
      }
    },
    "Слишком часто. Подожди минуту.": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çox tez-tez. Bir dəqiqə gözlə."
          }
        }
      }
    },
    "Типографика": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipoqrafiya"
          }
        }
      }
    },
    "Только что разобрали": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dəqiqə satıldı"
          }
        }
      }
    },
    "Цвета": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rənglər"
          }
        }
      }
    },
    "Цветочная лавка «Нар»": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "«Nar» gül dükanı"
          }
        }
      }
    },
    "Цены": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qiymətlər"
          }
        }
      }
    },
    "Этот букет уже у вас": {
      "localizations": {
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu buket artıq sizdədir"
          }
        }
      }
    }
  },
  "version": "1.0"
}
