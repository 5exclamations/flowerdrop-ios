<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Release. Никаких исключений ATS: боевой хост только по HTTPS. -->
<plist version="1.0">
<dict>
	<!--
	  Боевой адрес. Пока это поддомен хостинга: своего домена нет, а
	  api.flowerdrop.az стоял здесь авансом и указывал в никуда — релизная
	  сборка с ним не нашла бы бэкенд.
	  Когда домен появится, поменять надо ровно эту строку и привязать домен
	  на стороне хостинга; ATS-исключений тут нет и не нужно — HTTPS.
	-->
	<key>APIBaseURL</key>
	<string>https://flowerdrop-backend.onrender.com</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FlowerDrop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>az</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Только системный HTTPS: освобождённое использование шифрования,
	     иначе App Store Connect спрашивает про экспортное соответствие
	     на каждой сборке. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Launch screen без сториборда: фон и знак берутся из каталога ассетов. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>bg</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
