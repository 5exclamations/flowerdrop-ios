<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Debug. Отличается от релизного plist ровно двумя вещами:
  адрес бэкенда смотрит на localhost и разрешён HTTP — только для localhost.
  Релизная сборка этот файл не видит: INFOPLIST_FILE выбирается конфигурацией.
-->
<plist version="1.0">
<dict>
	<key>APIBaseURL</key>
	<string>http://localhost:8000</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>GoogleClientID</key>
	<string>400664300321-45uir9k7j16a11j4051mgs6i08cji6e5.apps.googleusercontent.com</string>
	<!-- Обратный client id как схема — так Google возвращает управление
	     в приложение после входа. Другого назначения у этой схемы нет. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.400664300321-45uir9k7j16a11j4051mgs6i08cji6e5</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>FlowerDrop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
		<string>az</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- Только системный HTTPS: освобождённое использование шифрования,
	     иначе App Store Connect спрашивает про экспортное соответствие
	     на каждой сборке. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Launch screen без сториборда: фон и знак берутся из каталога ассетов. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>bg</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
